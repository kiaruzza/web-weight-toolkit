{
  "name": "web-weight-toolkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Tools and bilingual guides to audit website weight, performance and sustainability",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "measure:weight": "node scripts/measure-page-weight.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "check:links": "node scripts/check-links.mjs",
    "lighthouse": "lhci autorun",
    "test": "node --test tests/*.test.mjs",
    "measure:network": "node scripts/measure-network.mjs",
    "metrics:ecoindex": "node scripts/import-ecoindex.mjs",
    "test:browser": "node --test tests-browser/*.test.mjs"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.54.2"
  }
}
